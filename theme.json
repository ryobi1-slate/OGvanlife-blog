{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "background": true,
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": false,
      "text": true,
      "palette": [
        { "slug": "graphite",        "color": "#1C1F22", "name": "Graphite" },
        { "slug": "graphite-light",  "color": "#252A2E", "name": "Graphite Light" },
        { "slug": "graphite-mid",    "color": "#2A2F34", "name": "Graphite Mid" },
        { "slug": "graphite-border", "color": "#333840", "name": "Graphite Border" },
        { "slug": "sand",            "color": "#C8B28A", "name": "Sand" },
        { "slug": "sand-dim",        "color": "#A89570", "name": "Sand Dim" },
        { "slug": "bone",            "color": "#F1ECE3", "name": "Bone" },
        { "slug": "steel",           "color": "#6E747A", "name": "Steel" },
        { "slug": "steel-light",     "color": "#8C9198", "name": "Steel Light" },
        { "slug": "alert",           "color": "#B23A2A", "name": "Alert" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Space Grotesk",
          "fontFamily": "'Space Grotesk', sans-serif",
          "fontFace": []
        },
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "'Inter', sans-serif",
          "fontFace": []
        },
        {
          "slug": "mono",
          "name": "JetBrains Mono",
          "fontFamily": "'JetBrains Mono', monospace",
          "fontFace": []
        }
      ],
      "fontSizes": [
        { "slug": "2xs",  "size": "0.625rem", "name": "2XS" },
        { "slug": "xs",   "size": "0.75rem",  "name": "XS" },
        { "slug": "sm",   "size": "0.875rem", "name": "Small" },
        { "slug": "base", "size": "1rem",     "name": "Base" },
        { "slug": "lg",   "size": "1.125rem", "name": "Large" },
        { "slug": "xl",   "size": "1.25rem",  "name": "XL" },
        { "slug": "2xl",  "size": "1.5rem",   "name": "2XL" },
        { "slug": "3xl",  "size": "1.875rem", "name": "3XL" },
        { "slug": "4xl",  "size": "2.25rem",  "name": "4XL" },
        { "slug": "5xl",  "size": "3rem",     "name": "5XL" },
        { "slug": "6xl",  "size": "3.75rem",  "name": "6XL" },
        { "slug": "7xl",  "size": "4.5rem",   "name": "7XL" }
      ]
    },
    "spacing": {
      "units": ["px", "%", "em", "rem", "vw", "vh"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "blocks": {
      "core/button": {
        "color": {
          "palette": []
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--graphite)",
      "text": "var(--wp--preset--color--bone)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.1"
        },
        "color": { "text": "var(--wp--preset--color--bone)" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.15"
        },
        "color": { "text": "var(--wp--preset--color--bone)" }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": { "text": "var(--wp--preset--color--bone)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--bone)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--sand)" }
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "single-van_doc",
      "title": "Van Doc Single",
      "postTypes": ["van_doc"]
    },
    {
      "name": "archive",
      "title": "Archive",
      "postTypes": ["van_doc"]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "patterns": []
}
